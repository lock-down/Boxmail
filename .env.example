# Copy to <Boxmail data directory>/.env, or set BOXMAIL_ENV_FILE to its absolute path.
# The settings UI writes credentials automatically. Values are plaintext secrets.
# Keys are case-sensitive; keep account/provider IDs exactly as stored in Boxmail.
# Hyphens are valid in this dotenv file. Do not source this file in a shell.
# Double-quoted values use JSON escapes; single-quoted values are literal.
BOXMAIL_AI_KEY=""

# Custom provider: replace custom-api with its Provider ID.
# BOXMAIL_AI_PROVIDER_custom-api_KEY="your-api-key"

# Mail account: replace account-id with its ID from an exported configuration.
# BOXMAIL_MAIL_account-id_PASSWORD="your-mail-app-password"

# Settings saves and configuration imports generate BOXMAIL_CONFIGURATION_<UUID> entries.
# An existing SQLite reference takes precedence over the direct names above.
# Keep their names when editing; Boxmail stores the matching references in SQLite.
